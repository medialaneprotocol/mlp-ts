{
  "name": "@medialaneprotocol/mlp",
  "version": "0.1.0",
  "description": "TypeScript reference implementation of the Media Lane Protocol: fragment codec, object assembler, lane client, resume, and path selection.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pdu": "./src/media-pdu.ts",
    "./client": "./src/media-client.ts",
    "./resume": "./src/media-resume.ts",
    "./path": "./src/media-path.ts",
    "./constants": "./src/protocol-constants.ts"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "generate:check": "npm --prefix ../mlp-proto run generate:check"
  },
  "dependencies": {
    "@medialaneprotocol/proto": "file:../mlp-proto"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
